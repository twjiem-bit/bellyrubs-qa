# Copy this file to scripts/.env and fill it in. scripts/.env is gitignored.
# Both values come from the bellyrubs-qa project: Supabase dashboard -> Project Settings -> API.
# The SERVICE ROLE key bypasses every policy. It lives ONLY here, on the founder' PC. Never in config.js, never in git.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key-here
